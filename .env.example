# Vite app (front-end) - copy to .env and fill in
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (send-order-email)
# Set these in Supabase Dashboard: Project → Edge Functions → Secrets
# (or via CLI: supabase secrets set RESEND_API_KEY=re_xxx)
# Do NOT put these in .env for the Vite app - they are only used by the edge function.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=Uptown Upholstery
# ORDER_NOTIFICATION_EMAIL=upholsteryuptown@gmail.com
